{
  "name": "@mirohq/rich-text-delta",
  "version": "0.0.1",
  "description": "Format for representing rich text documents and changes.",
  "keywords": [
    "delta",
    "operational transform",
    "ot",
    "rich text"
  ],
  "homepage": "https://github.com/miroapp/rich-text-delta",
  "bugs": {
    "url": "https://github.com/miroapp/rich-text-delta/issues"
  },
  "license": "MIT",
  "author": "Miro",
  "repository": {
    "type": "git",
    "url": "https://github.com/miroapp/rich-text-delta"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:watch": "vitest",
    "test": "vitest run",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "fast-diff": "^1.3.0",
    "lodash.isequal": "^4.5.0"
  },
  "devDependencies": {
    "@types/lodash.clone": "^4.5.6",
    "@types/lodash.clonedeep": "^4.5.6",
    "@types/lodash.isequal": "^4.5.5",
    "@types/node": "^25.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "ts-node": "^10.7.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
